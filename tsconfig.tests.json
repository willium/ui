{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "references": [{ "path": "tsconfig.packages.json" }],
  "include": [
    "**/vitest.*.ts", // All vitest config files across all packages
    "./packages/*/test/**/*.ts",
    "./packages/*/typetest/**/*.ts",
    "./packages/*/benchmark/**/*.ts",
    // The `virtual:@effect/ui/document` types, which the Vite fixture's server entry uses.
    "./packages/ui/src/html/HtmlServerViteDocument.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "./packages/ui/benchmark/types/tmp/**"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      // These path aliases let tests load internal modules and type check against the sources.
      "@effect/ui": ["./packages/ui/src/index.ts"],
      "@effect/ui/testing": ["./packages/ui/src/testing/index.ts"],
      "@effect/ui/html": ["./packages/ui/src/html/index.ts"],
      "@effect/ui/html/testing": ["./packages/ui/src/html/testing/index.ts"],
      "@effect/ui/*": ["./packages/ui/src/*.ts"],
      "@effect/ui-kit": ["./packages/ui-kit/src/index.ts"],
      "@effect/ui-kit/*": ["./packages/ui-kit/src/*.ts"],
      "@effect/ui-devtools": ["./packages/ui-devtools/src/index.ts"],
      "@effect/ui-devtools/*": ["./packages/ui-devtools/src/*.ts"],
      "@effect/ui-opentui": ["./packages/ui-opentui/src/index.ts"],
      "@effect/ui-opentui/testing": [
        "./packages/ui-opentui/src/testing/index.ts"
      ],
      "@effect/ui-opentui/*": ["./packages/ui-opentui/src/*.ts"],
      "@effect/ui-native": ["./packages/ui-native/src/index.ts"],
      "@effect/ui-native/node": ["./packages/ui-native/src/node/index.ts"],
      "@effect/ui-native/*": ["./packages/ui-native/src/*.ts"]
    },
    "plugins": [{
      "name": "@effect/language-service",
      "effectFn": ["untraced"],
      "namespaceImportPackages": [],
      "includeSuggestionsInTsc": false,
      "ignoreEffectWarningsInTscExitCode": true,
      "ignoreEffectErrorsInTscExitCode": false,
      "overrides": [
        {
          "include": ["**/typetest/**/*.ts"],
          "options": {
            "diagnosticSeverity": {
              "floatingEffect": "off"
            }
          }
        }
      ],
      "diagnosticSeverity": {
        "unknownInEffectCatch": "off",
        "multipleEffectProvide": "off",
        "unstableApiUsage": "off",
        "effectFnOpportunity": "error"
      }
    }]
  }
}
